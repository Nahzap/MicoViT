# =============================================================================
# MicorizaeVision / MicoViT — primera subida: SOLO código + README.md
# Todo lo demás queda fuera del repositorio (datos, artefactos, docs internas).
# =============================================================================

# --- Entorno Python ---
.venv/
venv/
env/
.env
.env.*
*.egg-info/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- Datos e imágenes (NUNCA subir) ---
Data/
data/
**/Data/**
**/*.jpg
**/*.jpeg
**/*.png
**/*.tif
**/*.tiff
**/*.bmp
**/*.webp
**/*.csv
!configs/**/*.yaml

# --- Manifests, salidas, modelos, cache (generados en runtime) ---
manifests/
outputs/
runs/
models/
checkpoints/
cache/
locks/
*.lock

